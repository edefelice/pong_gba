#
# Makefile create a graphics library from grit output.
#
# Use for data array only.

#
# SETUP
#

export PATH := $(DEVKITARM)/bin:$(PATH)

GRIT := grit

.SUFFIXES:

include $(DEVKITARM)/base_rules

#
# (1) PROJECT DETAILS
#

# GFXTITLE -> lib name
# BUILD    -> temporary build files folder. Should NOT be empty!
# GFXDIRS  -> images folder list.
# GFXEXTS  -> image files extensions.


BUILD   := build
GFXDIRS := graphics
LIBDIRS := lib
GFXLIB  ?= $(LIBDIRS)/libgfx.a
GFXHDR  ?= all_gfx.h
GFXEXTS := png bmp

# EXCEPTIONS
# Add here special rules.
# GFXSPECIALS -> file removed from GFXFILES.
# OSPECIALS   -> file added to OFILES.

# es:
# export LOZLEVEL1 ?= $(notdir $(wildcard level1/*.png))
# export PALMERGE  ?= $(notdir $(wildcard palmerge/*.png))

# export GFXSPECIALS := $(LOZLEVEL1) $(PALMERGE)
# OSPECIALS          := level1.o palmerge.o

# BUILD FLAGS

CFLAGS   :=
CXXFLAGS := $(CFLAGS) -fno-rtti -fno-exceptions
ASFLAGS  :=

#
# (2) BUILD PROCEDURE
#

ifneq ($(BUILD), $(notdir $(CURDIR)))

# Inside the project folder.

export TARGET  := $(CURDIR)/$(GFXLIB)
export VPATH   := $(foreach dir, $(GFXDIRS), $(CURDIR)/$(dir))
export DEPSDIR := $(CURDIR)/$(BUILD)

GFXFILES       := $(filter-out $(GFXSPECIALS), \
				  $(foreach dir, $(GFXDIRS), \
				  $(foreach ext, $(GFXEXTS), \
				  $(notdir $(wildcard $(dir)/*.$(ext))) \
				  )))
export OFILES  := $(addsuffix .o, $(basename $(GFXFILES))) $(OSPECIALS)

.PHONY: $(BUILD) clean

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@[ -d $(LIBDIRS) ] || mkdir -p $(LIBDIRS)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/gfxmake

clean:
	@echo clean...
	@rm -fr $(BUILD) $(TARGET) $(GFXHDR) $(LIBDIRS)

else

DEPENDS := $(OFILES:.o=.d)

.PHONY: all

all: $(TARGET) $(GFXHDR)

$(TARGET): $(OFILES)
	@echo "Archiving into $(notdir $@)"
	-@rm -f $@
	@$(AR) rcs $@ $(OFILES)

$(GFXHDR): $(OFILES)
	@echo "Creating master header: $@"
	@$(call master-header, $@, $(notdir $(^:.o=.h)))

#
# (3) BASE RULES
#

# with separate .grit file

%.s %.h: %.png %.grit
	$(GRIT) $< -fts

%.s %.h: %.bmp %.grit
	$(GRIT) $< -fts

%.s %.h: %.pcx %.grit
	$(GRIT) $< -fts

%.s %.h: %.jpg %.grit
	$(GRIT) $< -fts

# whitout .grit file; use dirname/dirname.grit for the options.

%.s %.h: %.png
	$(GRIT) $< -fts -ff $(<D)/$(notdir $(<D)).grit

%.s %.h: %.bmp
	$(GRIT) $< -fts -ff $(<D)/$(notdir $(<D)).grit

%.s %.h: %.pcx
	$(GRIT) $< -fts -ff $(<D)/$(notdir $(<D)).grit

%.s %.h: %.jpg
	$(GRIT) $< -fts -ff $(<D)/$(notdir $(<D)).grit

# (4) SPECIAL RULES

# (5) OTHER USEFUL FUNCTIONS

# Composing a single header file to facilitate graphics inclusion.

define master-header # $1 : master path, $2 separated headers paths
	echo -e "//\n// $(notdir $(strip $1))\n//" > $1
	echo -e "// Header that merges all graphics headers" >> $1
	echo -e "// Date: $(shell date +'%F %T')\n" >> $1
	echo -e "#ifdef __cplusplus\nextern \"C\"{\n#endif" >> $1
	cat $2 >> $1
	echo -e "\n#ifdef __cplusplus\n};\n#endif\n" >> $1
	mv $1 ../include/
endef

# Dependencies

-include $(DEPENDS)

endif